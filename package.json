{
  "name": "ag-ide-agent-token-usage-estimator",
  "displayName": "AG IDE Agent Token Usage Estimator",
  "publisher": "zenpasha",
  "version": "1.0.0",
  "description": "Real-time pre-execution token/tool estimations, model quota indicators, and settings dashboard for Antigravity IDE",
  "type": "module",
  "main": "./extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/gentlewatcher/ag-ide-agent-token-usage-estimator.git"
  },
  "bin": {
    "antigravity-usage": "dist/index.js",
    "ag-estimator": "dist/index.js"
  },
  "activationEvents": [
    "onStartupFinished",
    "*"
  ],
  "contributes": {
    "commands": [
      {
        "command": "antigravityUsage.statusBarMenu",
        "title": "Antigravity Usage: Show Quick Actions Menu",
        "category": "Antigravity Usage"
      },
      {
        "command": "antigravityUsage.refreshQuota",
        "title": "Antigravity Usage: Refresh Model Quotas & Estimation",
        "category": "Antigravity Usage"
      },
      {
        "command": "antigravityUsage.openSettingsFile",
        "title": "Antigravity Usage: Open Settings File in Editor",
        "category": "Antigravity Usage"
      },
      {
        "command": "antigravityUsage.openSettingsWeb",
        "title": "Antigravity Usage: Open Web Settings Dashboard",
        "category": "Antigravity Usage"
      },
      {
        "command": "antigravityUsage.triggerWakeup",
        "title": "Antigravity Usage: Trigger Model Wakeup / Warmup",
        "category": "Antigravity Usage"
      }
    ],
    "configuration": {
      "title": "Antigravity Usage & Estimator",
      "properties": {
        "antigravityUsage.defaultModel": {
          "type": "string",
          "default": "gemini-3.7-flash",
          "enum": [
            "gemini-3.7-flash",
            "gemini-2.5-flash",
            "gemini-3.7-pro",
            "gemini-2.5-pro",
            "claude-3-7-sonnet",
            "claude-3-5-sonnet",
            "gpt-4o",
            "deepseek-r1",
            "gemma-2"
          ],
          "description": "Default target model for pre-execution token and tool call estimation."
        },
        "antigravityUsage.statusBarDisplayMode": {
          "type": "string",
          "default": "detailed",
          "enum": ["detailed", "compact", "model-tag", "minimal"],
          "description": "Format style of the badge displayed in the Antigravity IDE bottom status bar."
        },
        "antigravityUsage.tokenWarningThreshold": {
          "type": "number",
          "default": 100000,
          "description": "Estimated token threshold that triggers a warning badge highlight in the status bar."
        },
        "antigravityUsage.refreshInterval": {
          "type": "number",
          "default": 60,
          "description": "Interval in seconds to automatically refresh model quotas in the status bar (0 to disable)."
        },
        "antigravityUsage.autoSyncTranscripts": {
          "type": "boolean",
          "default": true,
          "description": "Automatically discover and index agent conversation transcripts in the background."
        }
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "deploy:extension": "tsx scripts/deploy-extension.ts",
    "clean:extension": "tsx scripts/deploy-extension.ts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "antigravity",
    "quota",
    "cli",
    "google-cloud-code"
  ],
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "engines": {
    "node": ">=18",
    "vscode": "^1.80.0"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@types/inquirer": "^9.0.9",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "inquirer": "^9.3.8",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/vscode": "^1.136.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
